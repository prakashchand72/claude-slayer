#!/usr/bin/env bash
# tanuki-go <domain>
#
# One command. Starts Colima, starts the tanuki proxy container, registers the
# target (and all its subdomains), then drops you into a wired Claude Code.
#
#   ./tanuki-go example.com
#   ./tanuki-go '*.example.com'      # the wildcard is fine, it is stripped
set -euo pipefail
cd "$(dirname "$0")"

TARGET="${1:-}"
if [ -z "$TARGET" ]; then
  echo "usage: ./tanuki-go <domain>    e.g.  ./tanuki-go example.com  or  './tanuki-go *.example.com'"
  exit 1
fi

# Strip a leading "*.", a scheme, and any path, so all these give example.com:
#   *.example.com   https://example.com/login   example.com
DOMAIN="${TARGET#\*.}"
DOMAIN="${DOMAIN#http://}"; DOMAIN="${DOMAIN#https://}"; DOMAIN="${DOMAIN%%/*}"

say() { printf '\033[36m[tanuki-go]\033[0m %s\n' "$*"; }

say "target: $DOMAIN  (covers *.$DOMAIN)"

# 1) Colima (the Docker engine) up
if ! colima status >/dev/null 2>&1; then
  say "starting Colima..."
  colima start
fi

# 2) proxy container up (dev override = the patched cloak build)
say "starting proxy..."
docker compose -f docker-compose.yaml -f compose.dev.yaml up -d >/dev/null

# 3) wait until the proxy answers
printf '\033[36m[tanuki-go]\033[0m waiting for proxy on 18080'
for _ in $(seq 1 30); do
  if docker compose exec -T tanuki /tanuki status >/dev/null 2>&1; then printf ' ok\n'; break; fi
  printf '.'; sleep 1
done

# 4) register the target + its subdomains (scope covers *.DOMAIN)
./tanuki add "$DOMAIN"        </dev/null >/dev/null 2>&1 || true
./tanuki scope add "$DOMAIN"  </dev/null >/dev/null 2>&1 || true
say "registered. mapping table:"
./tanuki map </dev/null 2>&1 | grep -iF "$DOMAIN" || true

# 5) hand off straight into a wired Claude Code
if command -v claude >/dev/null 2>&1; then
  say "launching Claude Code — hunt away."
  exec claude
else
  say "ready. now run:  claude    (from $(pwd))"
fi
